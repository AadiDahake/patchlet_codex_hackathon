# Copy to .env.local (apps/web) or export in your shell. Names only, never commit values.

# --- Secrets (server-side only, never exposed to the browser) ---
OPENAI_API_KEY=             # OpenAI API key, used by every model call
SUPABASE_URL=               # https://<ref>.supabase.co
SUPABASE_ANON_KEY=          # anon key, the value behind NEXT_PUBLIC_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=  # service role key, server-side only
DATABASE_URL=               # Postgres session-mode pooler URL, migrations only
GITHUB_TOKEN=               # fine-grained PAT with contents/issues/pull-requests on the target repo
VERCEL_TOKEN=               # Vercel token, used to watch the target project's deployments
RUNLOOP_API_KEY=            # Runloop API key; the forge engine's devboxes (runloop strategy, and the agent's devbox under reflex)
REFLEX_API_KEY=             # Reflex API key (rfx_...); the forge engine's primary path, personas launched by id
GITHUB_OAUTH_CLIENT_ID=     # OAuth app that lets a console user link their own GitHub account
GITHUB_OAUTH_CLIENT_SECRET= # secret of that OAuth app
GITHUB_OAUTH_REDIRECT=      # https://<app>/api/github/callback, must match the OAuth app exactly

# --- Non-secret configuration ---
PATCHLET_PROJECT_SLUG=novaair                     # slug the seed script gives the demo project
PATCHLET_DEMO_OWNER_EMAIL=                        # account the seed hands the demo project to, blank leaves it unowned
PATCHLET_SITE_URL=                                # where NovaAir is deployed, blank leaves the seed's site unset
PATCHLET_REPO=                                    # owner/name of the NovaAir repository the demo files against
ESCALATION_ENGINE=local                           # 'local' for the worker's local runner, 'forge' for the sandbox engine in apps/web/lib/forge
FORGE_STRATEGY=                                   # 'reflex' | 'runloop' | 'local'; blank picks reflex, then runloop, then local, by which keys are set
FORGE_TARGET_REPO=AadiDahake/novaair              # owner/name a forge run targets when the project has no repository bound
FORGE_LOCAL_CACHE_DIR=                            # where the local strategy keeps its clone and worktrees; blank uses the OS temp dir
RUNLOOP_BLUEPRINT=                                # optional Runloop blueprint with Codex and the target's dependencies baked in
REFLEX_ORGANIZATION_ID=doing_something            # the Reflex organization (org_... id or slug) sent as x-organization-id
REFLEX_API_URL=https://reflex.runloop.ai/api      # the Reflex API base
REFLEX_PERSONA_CAPABILITY_BUILDER=                # prs_... id of the Capability Builder persona in the Reflex web app
REFLEX_PERSONA_UX_BUILDER=                        # prs_... id of the UX Builder persona
REFLEX_PERSONA_CAPABILITY_VERIFIER=               # prs_... id of the Capability Verifier persona
NEXT_PUBLIC_APP_URL=http://localhost:3000         # public origin of the dashboard, base of the widget script URL
TARGET_VERCEL_PROJECT=novaair                     # Vercel project whose deployment the worker waits for
SLACK_WEBHOOK_URL=                                # optional Slack incoming webhook; the worker posts once when the issue is filed and once when the draft PR opens

# --- Public configuration (inlined into the browser bundle) ---
# Both values are public by design: the anon key only ever reaches Supabase Auth, which enforces
# row level security. They equal SUPABASE_URL and SUPABASE_ANON_KEY above.
NEXT_PUBLIC_SUPABASE_URL=                         # https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=                    # Supabase anon key, used by the sign-in screen
